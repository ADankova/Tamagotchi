{
  "name": "tamagotchi",
  "version": "1.28.0",
  "private": true,
  "type": "module",
  "description": "Игра «Тамагочи» для Android на TypeScript",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "android:icons": "node scripts/android-icons.mjs android/app/src/main/res",
    "android:sync": "npm run build && cap sync android",
    "android:theme": "node scripts/android-theme.mjs android/app/src/main/res",
    "android:gradle": "node scripts/android-gradle.mjs android/app/build.gradle",
    "android:manifest": "node scripts/android-manifest.mjs android/app/src/main/AndroidManifest.xml"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@fontsource-variable/nunito": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^9.15.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
